# DTB 说明（过渡期双硬件）:
#   myd-lmx9x-11x11-custom.dtb     产品固定加载名：U-Boot fdtfile 与 SWUpdate
#                                  KERNEL_SWU_DTB 都用它，内容 = Pin List v2
#                                  （custom.dts 只是 include，见文件头注释）
#   myd-lmx9x-11x11-custom-v1.dtb  旧板（Pin List v1）快照，供现场切回/回归测试

dtb-$(CONFIG_ARCH_MXC) += myd-lmx9x-11x11.dtb \
			  myd-lmx9x-11x11-hdmi.dtb \
			  myd-lmx9x-11x11-rgb.dtb \
			  myd-lmx9x-11x11-lvds.dtb \
			  myd-lmx9x-11x11-custom.dtb \
			  myd-lmx9x-11x11-custom-v1.dtb \
			  myd-lmx9x-11x11-convergence-terminal.dtb
